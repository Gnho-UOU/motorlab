{
  "name": "motorlab-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@react-three/drei": "9.105.6",
    "@react-three/fiber": "8.16.8",
    "@react-three/postprocessing": "2.16.2",
    "postprocessing": "6.35.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.1",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "31.3.1",
    "electron-builder": "24.13.3",
    "typescript": "5.4.5",
    "vite": "5.2.11"
  },
  "description": "Motor Lab: EV 구동모터 해석 스튜디오 (웹 + 데스크톱)",
  "author": "Motor Lab",
  "build": {
    "appId": "kr.motorlab.studio",
    "productName": "Motor Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../api",
        "to": "api",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "!benchmarks/raw/**"
        ]
      },
      {
        "from": "../femm/prius_sector.py",
        "to": "femm/prius_sector.py"
      },
      {
        "from": "dist",
        "to": "web/dist"
      },
      {
        "from": "sidecar",
        "to": ".",
        "filter": [
          "motorlab-server*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}